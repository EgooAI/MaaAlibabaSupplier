# Yak MITM 流量转发脚本

YAK_MITM_HOST = "127.0.0.1"
MITM_PORT = 8084  // 监听该端口的流量
INTERNAL_TOKEN = os.Getenv("MAA_MITM_INTERNAL_TOKEN")
if INTERNAL_TOKEN == "" {
    println("[!] MAA_MITM_INTERNAL_TOKEN is required; set the same private token for Yak and the receiver")
    os.Exit(1)
}
if !re.Match("^[A-Za-z0-9._~+/-]+=*$", INTERNAL_TOKEN) || str.StartsWith(INTERNAL_TOKEN, "maa_") {
    println("[!] MAA_MITM_INTERNAL_TOKEN must be an ASCII bearer token distinct from browser session tokens (maa_)")
    os.Exit(1)
}
RECEIVER_HOST = str.TrimSpace(os.Getenv("MITM_RECEIVER_HOST"))
if RECEIVER_HOST == "" {
    RECEIVER_HOST = "127.0.0.1"
}
if str.ToLower(RECEIVER_HOST) == "localhost" {
    RECEIVER_HOST = "127.0.0.1"
}
RECEIVER_PORT = str.TrimSpace(os.Getenv("MITM_RECEIVER_PORT"))
if RECEIVER_PORT == "" {
    RECEIVER_PORT = "8085"
}
if str.Contains(RECEIVER_HOST, ":") && !str.Contains(RECEIVER_HOST, "[") {
    RECEIVER_HOST = "[" + RECEIVER_HOST + "]"
}
PYTHON_RECEIVER = "http://" + RECEIVER_HOST + ":" + RECEIVER_PORT + "/internal/traffic"

// Known API keywords — capture body for these
API_KEYWORDS = ["queryCustomerInfo", "getuserinfobyparams", "icbu.im.id.get", "contact.extinfo.get", "fetchcard"]

// Liveness counters: the Python receiver only ever sees the keywords above, so
// only this proxy can tell "no client traffic" from "traffic but no match".
seenCount = 0
matchedCount = 0

postToPython = fn(payload) {
    rsp, err = http.Post(
        PYTHON_RECEIVER,
        http.header("Content-Type", "application/json"),
        http.header("Authorization", "Bearer " + INTERNAL_TOKEN),
        http.body(payload),
        http.noredirect(),
    )
    if err != nil {
        println("[!] Forwarding to Python failed (transport error)")
        return
    }
    if rsp.StatusCode < 200 || rsp.StatusCode >= 300 {
        println("[!] Forwarding to Python failed: HTTP " + string(rsp.StatusCode))
    }
}

matchesApi = fn(rawUrl) {
    for kw = range API_KEYWORDS {
        if rawUrl[kw] >= 0 {
            return true
        }
    }
    return false
}

// handleHijackResponse uses mitm.hijackHTTPResponseEx to capture response body
// from the MITM proxy's raw response bytes (already decompressed by the proxy).
// This is non-consuming — rspRaw is a copy, not a stream read.
handleHijackResponse = fn(isHttps, urlStr, reqRaw, rspRaw, forward, dropped) {
    seenCount = seenCount + 1
    if !matchesApi(urlStr) {
        forward(rspRaw)
        return
    }
    matchedCount = matchedCount + 1

    // Extract body from raw response bytes (minimum poc calls)
    respBody = ""
    try {
        respBody = poc.GetHTTPPacketBody(string(rspRaw))
    } catch e {
        println("[!] GetHTTPPacketBody failed: " + string(e))
        forward(rspRaw)
        return
    }

    if respBody == "" {
        forward(rspRaw)
        return
    }

    // Extract method from raw request bytes (built-in poc function)
    method = "GET"
    try {
        method = poc.GetHTTPRequestMethod(string(reqRaw))
    } catch e {
    }

    try {
        payload = json.dumps({
            "is_https":         isHttps,
            "url":              urlStr,
            "method":           method,
            "request_headers":  {},
            "request_body":     "",
            "status_code":      0,
            "response_headers": {},
            "response_body":    respBody,
        })
        go postToPython(payload)
    } catch e {
        println("[!] payload error: " + string(e))
    }
    forward(rspRaw)
}

hijackCb = mitm.hijackHTTPResponseEx(handleHijackResponse)
go mitm.Start(
    MITM_PORT,
    mitm.host(YAK_MITM_HOST),
    hijackCb,
)

sleep(1)
println("[*] Yak MITM 代理已启动于 " + YAK_MITM_HOST + ":" + string(MITM_PORT))
println("[*] 流量链路：APP -> " + YAK_MITM_HOST + ":" + string(MITM_PORT) + " -> " + PYTHON_RECEIVER)
println("[*] 需要设置被劫持的 APP 的网络代理为 " + YAK_MITM_HOST + ":" + string(MITM_PORT))

for {
    sleep(300)
    println("[*] Yak MITM tick seen=" + string(seenCount) + " matched=" + string(matchedCount))
}
