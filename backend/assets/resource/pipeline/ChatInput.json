{
    "ChatInput": {
        "desc": "【入口点】聚焦并输入聊天文本，调用方需显式指定是否点击发送",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "ChatInput_GoToInput"
        ]
    },
    "ChatInput_GoToInput": {
        "desc": "聚焦到聊天输入框，通过点击发送按钮上方空白处",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Chat/按钮_发送_禁用.png",
                    "Chat/按钮_发送_可用.png"
                ], // 二者匹配其一
                "roi": [
                    616,
                    579,
                    303,
                    197
                ],
                "order_by": "Score"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    0,
                    -45,
                    0,
                    0
                ]
            }
        },
        "next": [
            "ChatInput_PasteText"
        ]
    },
    "ChatInput_PasteText": {
        "desc": "原生组合键全选、清空、粘贴并读回核对正文",
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PasteChatText",
                "custom_action_param": {"text": ""}
            }
        },
        "next": []
    },
    "ChatInput_SendOnly": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "ChatInput_SendMessage"
        ]
    },
    "ChatInput_SendMessage": {
        "desc": "仅点击可用的发送按钮，不代表平台已确认发送",
        "enabled": false,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "Chat/按钮_发送_可用.png"
                ],
                "roi": [
                    616,
                    579,
                    303,
                    197
                ],
                "order_by": "Score"
            }
        },
        "action": {
            "type": "Click"
        }
    }
}
