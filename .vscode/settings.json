{
    "black-formatter.args": [
        "-l",
        "120"
    ],
    "json.schemas": [
        {
            "fileMatch": [
                "/backend/assets/resource/**/*.json",
                "/install/backend/assets/resource/**/*.json",
                "/backend/assets/resource/**/*.jsonc",
                "/install/backend/assets/resource/**/*.jsonc"
            ],
            "url": "/backend/deps/tools/pipeline.schema.json"
        },
        {
            "fileMatch": [
                "/backend/assets/interface.json",
                "/install/backend/assets/interface.json"
            ],
            "url": "/backend/deps/tools/interface.schema.json"
        },
        {
            "fileMatch": [
                "/backend/assets/config/maa_pi_config.json",
                "/install/backend/assets/config/maa_pi_config.json"
            ],
            "url": "/backend/deps/tools/interface_config.schema.json"
        }
    ],
    "files.associations": {
        "**/backend/assets/**/*.json": "jsonc"
    },
    "[json][jsonc]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.indentSize": "tabSize"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
    },
    "[markdown]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    }
}