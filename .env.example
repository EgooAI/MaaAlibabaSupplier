# MITM proxy (Yak): auto-started by main program via yak_mitm.yak.
MITM_PROXY_HOST=127.0.0.1
MITM_PROXY_PORT=8084

# MITM v4 receiver: Python app listens here for Yak/Yakit forwarded traffic.
MITM_RECEIVER_HOST=127.0.0.1
MITM_RECEIVER_PORT=8085

# HTTP API server (Next.js frontend proxies /api/* here)
MAA_API_HOST=127.0.0.1
MAA_API_PORT=8787

# Required: SHA-256 hex digest of the fixed login secret (UTF-8, no trimming).
# Never use a shared/default secret. See backend/app/api/AUTH.md for provisioning.
# Missing or invalid configuration prevents application startup.
# python -c "import getpass,hashlib; print(hashlib.sha256(getpass.getpass('Fixed secret: ').encode('utf-8')).hexdigest())"
MAA_AUTH_SECRET_SHA256=

# Permanent sessions default to backend/data/auth.sqlite, separate from CRM.
# Optional absolute path; relative overrides resolve against the working directory.
# MAA_AUTH_DB_PATH=

# The supported API deployment is one process: login admission is globally 0.5 RPS.
# MAA_MITM_INTERNAL_TOKEN is generated by the launcher; do not set it for normal use.

# SQLite path for MITM pools
MAA_POOLS_DB_PATH=data/pools.db

# SQLite path for CRM (relative to backend/ unless absolute)
MAA_CRM_DB_PATH=data/crm.sqlite

# Yak executable override (optional; default PATH then backend/.portable/yak/yak.exe)
# YAK_EXECUTABLE=yak

# SMTP server hostname
EMAIL_SMTP_SERVER=smtpdm.aliyun.com
# SMTP server port
EMAIL_SMTP_PORT=80
# SMTP auth username
EMAIL_SMTP_USERNAME=your-name@notify.example.com
# SMTP auth password
EMAIL_SMTP_PASSWORD=replace-with-your-password
# Default sender address
EMAIL_FROM_ADDRESS=your-name@notify.example.com
# Default sender display name
EMAIL_FROM_NAME=MaaAlibabaSupplier
